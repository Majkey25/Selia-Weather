<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PocasiCesko" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="WidgetText">
        <item name="android:gravity">start</item>
    </style>

    <style name="WidgetText.System">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="WidgetText.Material">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="WidgetText.Rounded">
        <item name="android:fontFamily">sans-serif-rounded</item>
    </style>

    <style name="WidgetText.Light">
        <item name="android:fontFamily">sans-serif-light</item>
    </style>
    <style name="WidgetText.System.Center">
        <item name="android:gravity">center_horizontal</item>
    </style>
    <style name="WidgetText.System.Right">
        <item name="android:gravity">end</item>
    </style>
    <style name="WidgetText.Material.Center">
        <item name="android:gravity">center_horizontal</item>
    </style>
    <style name="WidgetText.Material.Right">
        <item name="android:gravity">end</item>
    </style>
    <style name="WidgetText.Rounded.Center">
        <item name="android:gravity">center_horizontal</item>
    </style>
    <style name="WidgetText.Rounded.Right">
        <item name="android:gravity">end</item>
    </style>
    <style name="WidgetText.Light.Center">
        <item name="android:gravity">center_horizontal</item>
    </style>
    <style name="WidgetText.Light.Right">
        <item name="android:gravity">end</item>
    </style>
</resources>
